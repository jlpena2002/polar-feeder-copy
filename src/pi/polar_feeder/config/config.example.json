# Example configuration for the Polar Feeder project. Copy this file to `config.json` onto the Raspberry Pi and edit the values as needed before running the feeder. The config is organized into sections for each subsystem, with comments explaining the purpose of each parameter. 
#These values were used during Demo Day and are a good starting point for testing, but feel free to adjust them based on your specific setup and requirements. Make sure to keep the JSON format valid when editing the file.
{
  "lure": {
    "motion_threshold": 30.0,
    "retract_delay_ms": 500,
    "cooldown_s": 2.0
  },
  "inverse": {
    "motion_threshold": 20.0,
    "stillness_min_duration_s": 1.5,
    "noise_buffer_multiplier": 1.5,
    "cooldown_s": 2.0
  },
  "logging": {
    "enabled": true,
    "telemetry_hz": 5,
    "max_storage_mb": 500,
    "log_dir": "logs"
  },
  "radar": {
    "enabled": true,
    "port": "/dev/ttyACM0",
    "baud": 115200,
    "timeout_s": 0.1,
    "zone_m": [1.0, 2.0, 3.0],
    "distance_jump_m": 0.20,
    "detection_distance_m": 3.0
  },
  "safety": {
    "ble_disconnect_safe_idle": false
  },
  "actuator": {
    "pulse_ms": 200,
    "feeding_distance_m": 0.5
  },
  "vision": {
    "enabled": true,
    "sync_window_s": 0.5
  }
}